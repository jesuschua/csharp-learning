<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="MySimpleAvaloniaApp.MainWindow"
        Title="My First Avalonia App"
        Width="500" Height="400">
    
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Welcome to My First Avalonia App!" 
                   FontSize="24" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
        
        <!-- Greeter Section -->
        <Border BorderBrush="Gray" BorderThickness="1" Padding="15" CornerRadius="5">
            <StackPanel Spacing="10">
                <TextBlock Text="Greeter" FontSize="18" FontWeight="SemiBold"/>
                <TextBox Name="NameTextBox" 
                         PlaceholderText="Enter your name..." 
                         Width="300"/>
                <Button Name="GreetButton" 
                        Content="Greet Me" 
                        Click="GreetButton_Click"
                        Width="150"/>
                <TextBlock Name="GreetingLabel" 
                           FontSize="16" 
                           Foreground="Green"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Calculator Section -->
        <Border BorderBrush="Gray" BorderThickness="1" Padding="15" CornerRadius="5">
            <StackPanel Spacing="10">
                <TextBlock Text="Simple Calculator" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Name="Number1TextBox" 
                             PlaceholderText="First number" 
                             Width="100"/>
                    <TextBlock Text="+" VerticalAlignment="Center" FontSize="20"/>
                    <TextBox Name="Number2TextBox" 
                             PlaceholderText="Second number" 
                             Width="100"/>
                    <Button Name="CalculateButton" 
                            Content="Calculate" 
                            Click="CalculateButton_Click"/>
                </StackPanel>
                <TextBlock Name="ResultLabel" 
                           FontSize="16" 
                           Foreground="Blue"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
